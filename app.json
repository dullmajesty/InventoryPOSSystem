{
  "expo": {
    "name": "SST Inventory Management",
    "slug": "SSTInventoryManagement",
    "scheme": "com.pos.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/samsantek-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/samsantek-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/samsantek-image.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/samsantek-icon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
